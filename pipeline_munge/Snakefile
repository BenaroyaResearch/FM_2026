# One of two snakemakes involved in the FM pipeline. 
# 
# This Snakefile within pipeline_munge is used to automatically download and munge GWASs
# within the config list. 
# 
# These steps have been kept separate from the true fine-mapping pipeline to help with debugging
# and to provide a download/munging tool for future, potentially unrelated, analyses. 

import pandas as pd
import sys, os, glob, re

workdir: "../"

# Adds shared folder (folder used for both pipelines) to Python's search path so Snakefile always
# has access. 
sys.path.insert(0, os.path.join(os.path.dirname(workflow.basedir), "shared"))
from load_study_info import load_study_info

# Filters study_table.tsv to studies listed in config_munge.yaml
configfile: "config/config_munge.yaml"
study_info = load_study_info(config)

print(f"Running {len(study_info)} studies: {list(study_info.keys())}")

# ---------------------------------------------------------------------------
# Containerization
# ---------------------------------------------------------------------------
# Every rule runs inside the image built from the Dockerfile at the repo root and
# published to ghcr.io/benaroyaresearch/fm_2026. It carries curl, file, gzip and GNU grep
# (with PCRE) for the shell rules, and R with MungeSumstats for munge_gwas. The
# SNPlocs/BSgenome reference data is deliberately not in the image — see config["ref_lib"]
# below.
#
# How the image actually gets applied depends on the executor, and the two paths are not
# interchangeable:
#
#   Kubernetes (how this is deployed, per the Coder workspace docs)
#       The k8s executor plugin ignores the `container:` directive below. It puts a
#       single image on every job pod, taken from --container-image, and runs Snakemake
#       inside that pod to execute the rule. So the image must be named on the command
#       line as well:
#
#           conda activate snakemake
#           snakemake --profile coder --jobs <n> \
#                     --container-image ghcr.io/benaroyaresearch/fm_2026:<tag> \
#                     --latency-wait 120 --keep-going --default-resources
#
#       Because the pod re-parses this Snakefile, the image needs Snakemake and pandas
#       too — the Dockerfile installs both. Drop --use-conda: no rule here declares a
#       conda env, and dependencies come from the image instead.
#
#   Local / Apptainer
#       `container:` below is the directive Apptainer honors, so a local run works with
#       --software-deployment-method apptainer and no extra flags. Note that Apptainer
#       bind-mounts little beyond the working directory, so if $TMPDIR points at scratch,
#       add --apptainer-args "--bind $TMPDIR" — download_gwas and check_gwas_coverage
#       stage multi-GB temp files there, and the coverage check decompresses the whole
#       GWAS.
#
# Do not combine `container:` with --sdm apptainer while on the Kubernetes executor. That
# combination asks for Apptainer nested inside the pod, which makes the plugin request
# privileged pods, and its own source notes that path does not currently work.
#
# Both paths read the same config key, so the declared image and the flag cannot drift.
if "container" not in config:
    sys.exit(
        "ERROR: config/config_munge.yaml is missing the 'container' key.\n"
        "Set it to the published image, e.g. ghcr.io/benaroyaresearch/fm_2026:v1.0.0"
    )

container: config["container"]

# ---------------------------------------------------------------------------
# Reference data library
# ---------------------------------------------------------------------------
# munge_sumstats.R needs the SNPlocs/BSgenome data packages, which are too large to ship
# in the image. Rather than commit a machine-specific path, the renv project library is
# discovered here, on the driver, where the project sits at its real absolute path.
#
# It has to be absolute: the k8s executor gives each pod an emptyDir at /workdir, so a
# relative path resolves against scratch space rather than the project. Absolute paths
# that work in the Coder workspace resolve identically inside job pods.
#
# Set ref_lib in the config (or --config ref_lib=/path) to override, which is what a
# standalone BiocManager library needs.

# Path component renv uses for the R version, which must match the image's R. Update
# this alongside the Bioconductor release in the Dockerfile.
CONTAINER_R_VERSION = "R-4.4"


def resolve_ref_lib(config):
    explicit = config.get("ref_lib")
    if explicit:
        return os.path.abspath(os.path.expanduser(explicit))

    # renv lays out <project>/renv/library/<platform>/<R-version>/<arch>
    found = sorted(p for p in glob.glob("renv/library/*/*/*") if os.path.isdir(p))

    if not found:
        sys.exit(
            "ERROR: no reference package library found.\n"
            "Expected an renv library at renv/library/<platform>/<R-version>/<arch> "
            f"under {os.getcwd()}.\n"
            "Run renv::restore() from the project root, or set 'ref_lib' in "
            "config/config_munge.yaml to a standalone library.\n"
            "To run the non-munge rules without a library present, pass "
            "--config ref_lib=/tmp."
        )

    if len(found) > 1:
        sys.exit(
            "ERROR: multiple renv libraries found, cannot pick one automatically:\n  "
            + "\n  ".join(found)
            + "\nSet 'ref_lib' in config/config_munge.yaml to the correct one."
        )

    return os.path.abspath(found[0])


ref_lib = resolve_ref_lib(config)
print(f"Reference package library: {ref_lib}")

# R refuses to load packages built by a newer R minor version, so a library keyed to a
# different R than the image is a guaranteed failure. Only checked when the path actually
# carries an R-<major>.<minor> component: a standalone BiocManager library says nothing
# about its R version in its name, so there is nothing to compare and no warning to give.
# Warn rather than abort, since the image and this constant can legitimately move together.
r_component = next(
    (p for p in ref_lib.split(os.sep) if re.fullmatch(r"R-\d+\.\d+", p)), None
)
if r_component and r_component != CONTAINER_R_VERSION:
    print(
        f"WARNING: {ref_lib} is a {r_component} library but the container image ships "
        f"{CONTAINER_R_VERSION}. R will refuse to load packages built under a different "
        "R minor version, so the munge step will fail until these agree.",
        file=sys.stderr,
    )

# Pipeline ultimately needs to produce:
#      1. fine-mapping decision file (both functional & regular, regular only, or none)
#      2. file containing study trait
rule all:
    input:
        expand("results/{study}/munged/{study}_fm_decision.txt", study=study_info.keys()),
        expand("results/{study}/raw/{study}_trait.txt", study=study_info.keys())

# Purpose: records the study's trait name as its own small file. 
# Standalone. Only for record-keeping. 
rule write_trait_file:
    output:
        "results/{study}/raw/{study}_trait.txt"
    params:
        trait = lambda wildcards: study_info[wildcards.study]["Trait"] # Look up trait
    shell:
        # Write trait to output file
        r"""
        echo "{params.trait}" > {output}
        """

# Purpose: determines the actual downloadable filename for a study's GWAS summary stats. 
# Checks for harmonized version first, falling back to the main directory, then a last-resort
# pattern match. 
# Outputs text file with filename. 
rule resolve_gwas_filename:
    output:
        "results/{study}/raw/{study}_filename.txt"
    params:
        dir_url = lambda wildcards: study_info[wildcards.study]["GWAS_dir_url"], # Gathers GWAS url
        log_path = lambda wildcards: study_info[wildcards.study]["log_file"] # Gathers log file path
    shell:
        r"""
        echo "$(date): checking for harmonised folder in {params.dir_url}" >> {params.log_path}

        # Searches for a link to harmonised/ subfolder
        HARM_CHECK=$(curl -s {params.dir_url}/ | grep -o 'href="harmonised/"') || true

        # If harmonised subfolder found, looks for harmonised sumstats via ".h."
        # If not, checks main directory for obvious sumstats file. 
        if [ -n "$HARM_CHECK" ]; then
            echo "$(date): harmonised folder found, looking inside" >> {params.log_path}
            FNAME=$(curl -s {params.dir_url}/harmonised/ | grep -oP '(?<=href=")[^"]*\.h\.[^"]*' | head -1) || true
            SUBFOLDER="harmonised/"
        else
            echo "$(date): no harmonised folder, checking main directory" >> {params.log_path}
            FNAME=$(curl -s {params.dir_url}/ | grep -oP '(?<=href=")[^"]*\.sumstats\.tsv\.gz' | head -1) || true
            SUBFOLDER=""
        fi

        # If no obvious sumstats file found, search for any filename containing the GCST ID and ending in .tsv.
        if [ -z "$FNAME" ]; then
            echo "$(date): WARNING: no obvious sumstats file found" >> {params.log_path}
            FNAME=$(curl -s {params.dir_url}/ | grep -oP "(?<=href=\")[^\"]*{wildcards.study}[^\"]*\.tsv[^\"]*" | head -1) || true
            SUBFOLDER=""
        fi

        # If all three attempts fail, record and end pipeline. 
        if [ -z "$FNAME" ]; then
            echo "$(date): no sumstats file found" >> {params.log_path}
            exit 1
        fi

        echo "$SUBFOLDER$FNAME" > {output}
        echo "$(date): resolved filename: $SUBFOLDER$FNAME" >> {params.log_path}
        """

# Purpose: download the GWAS from resolved file name. Ensures its a gzip-compressed regardless of GWAS catalog form. 
# Skips if output already exists. 
rule download_gwas:
    input:
        "results/{study}/raw/{study}_filename.txt"
    output:
        "results/{study}/raw/{study}_sumstats.tsv.gz"
    params:
        dir_url = lambda wildcards: study_info[wildcards.study]["GWAS_dir_url"],
        log_path = lambda wildcards: study_info[wildcards.study]["log_file"]
    shell:
        r"""
        # Checks if sumstats file already exists (manually placed there)
        if [ -s {output} ]; then
            echo "$(date): sumstats file already present at {output}, skipping download" >> {params.log_path}
            exit 0
        fi

        # Concatenating full url
        FNAME=$(cat {input})
        FULL_URL="{params.dir_url}/$FNAME"

        echo "$(date): downloading from $FULL_URL" >> {params.log_path}

        # Temp download prevents failed/partial downloads from confusing Snakemake
        TMP_DOWNLOAD=$(mktemp)
        curl -# "$FULL_URL" -o "$TMP_DOWNLOAD"

        # Checks that file is not empty.
        if [ ! -s "$TMP_DOWNLOAD" ]; then
            echo "STATUS: download not successful" >> {params.log_path}
            rm -f "$TMP_DOWNLOAD"
            exit 1
        fi

        # Checks if file has already been gzipped. If yes, move into place. If not, compress it. 
        if file -b "$TMP_DOWNLOAD" | grep -qi "gzip"; then
            mv "$TMP_DOWNLOAD" {output}
        else
            gzip -c "$TMP_DOWNLOAD" > {output}
            rm -f "$TMP_DOWNLOAD"
        fi

        echo "STATUS: downloaded successfully" >> {params.log_path}
        """

# Purpose: QC gate deciding whether a downloaded file has the minimum columns and SNP density to 
# be worth munging. 
rule check_gwas_coverage:
    input:
        "results/{study}/raw/{study}_sumstats.tsv.gz"
    output:
        "results/{study}/raw/{study}_coverage_check.txt"
    params:
        log_path = lambda wildcards: study_info[wildcards.study]["log_file"]
    shell:
        r"""
        # Decompresses to a temp file to check header. Fix for previous bug: piping a live scat into a head
        # caused pipeline to die mid-stream.
        TMP_FILE=$(mktemp)
        zcat {input} > "$TMP_FILE"

        # Gather the header and SNP count
        HEADER=$(head -1 "$TMP_FILE")
        SNP_COUNT=$(tail -n +2 "$TMP_FILE" | wc -l)

        # Always record header and SNP count, regardless of pass/fail outcome below.
        echo "$(date): coverage check — header: $HEADER" >> {params.log_path}
        echo "$(date): coverage check — snp_count: $SNP_COUNT" >> {params.log_path}

        # Possible names for required columns
        POSITION_COLS="hm_chrom hm_pos CHR BP chr_name chr_position chromosome base_pair_location"
        EFFECT_COLS="hm_beta BETA hm_odds_ratio OR beta odds_ratio"
        SE_COLS="standard_error SE hm_ci_lower"
        ZSCORE_COLS="Z Z_SCORE z_score ZSCORE"
        PVAL_COLS="p_value PVAL P"

        # Function that checks the header against a list of acceptable column-name variants per category
        # (position, effect size, standard error, Z-score, p-value)
        has_match() {{
            local candidates="$1"
            for col in $candidates; do
                if echo "$HEADER" | grep -qw "$col"; then
                    echo "$col"
                    return 0
                fi
            done
            return 1
        }}

        pos_found=$(has_match "$POSITION_COLS") || true
        effect_found=$(has_match "$EFFECT_COLS") || true
        se_found=$(has_match "$SE_COLS") || true
        z_found=$(has_match "$ZSCORE_COLS") || true
        pval_found=$(has_match "$PVAL_COLS") || true

        # Either direct z-column or effect size + standard error are sufficient (matches what SuSiE needs)
        if [ -n "$z_found" ]; then
            signal_ok="yes"
        elif [ -n "$effect_found" ] && [ -n "$se_found" ]; then
            signal_ok="yes"
        else
            signal_ok="no"
        fi

        rm -f "$TMP_FILE"

        echo "$(date): coverage check — position=$pos_found signal=$signal_ok pval=$pval_found snp_count=$SNP_COUNT" >> {params.log_path}

        # If position data is missing, signal data is insufficient. If SNP count is below 1,000,000 (designating in config file), signal
        # data is insufficient. 
        if [ -z "$pos_found" ] || [ "$signal_ok" = "no" ] || [ "$SNP_COUNT" -lt 1000000 ]; then
            echo "FAIL: coverage check failed. Sumstats file kept for manual review at results/{wildcards.study}/raw/{wildcards.study}_sumstats.tsv.gz" >> {params.log_path}
            exit 1
        fi

        # Flag oversized studies for memory planning and exit. Don't proceed to munge
        if [ "$SNP_COUNT" -gt 13000000 ]; then
            echo "$(date): FLAG: Study has over 13,000,000 SNPs. Adjust session memory requirements." >> {params.log_path}
            exit 1
        fi

        echo "PASS" > {output}
        """

# Purpose: munge GWAS to clean for downstream fine-mapping
rule munge_gwas:
    input:
        sumstats = "results/{study}/raw/{study}_sumstats.tsv.gz",
        coverage_check = "results/{study}/raw/{study}_coverage_check.txt",
        file_name = "results/{study}/raw/{study}_filename.txt"
    output:
        munged = "results/{study}/munged/{study}_munged.tsv.gz",
        decision = "results/{study}/munged/{study}_fm_decision.txt"
    threads: 4
    # Worth setting before running this on Kubernetes. The k8s executor turns threads
    # into the pod's CPU request and mem_mb into both its memory request AND limit; with
    # no mem_mb the pod is scheduled with no memory reservation at all and is first in
    # line to be killed under node pressure. That surfaces as exit code 137, which the
    # error handling below already reports as a likely OOM.
    #
    # disk_mb becomes the ephemeral-storage request and limit. It matters here because
    # check_gwas_coverage decompresses the entire GWAS through mktemp, which lands in the
    # pod's ephemeral storage unless $TMPDIR points somewhere shared. Either size disk_mb
    # for the largest uncompressed GWAS, or keep temp files off ephemeral storage with:
    #
    #     --default-resources tmpdir="'/path/on/shared/fs'"
    #
    # Snakemake exports resources.tmpdir as $TMPDIR for the job, and mktemp honors it.
    # resources:
    #     mem_mb = 32000

    # Required for shell/munging
    params:
        log_path = lambda wildcards: study_info[wildcards.study]["log_file"],
        n = lambda wildcards: study_info[wildcards.study]["n"],
        n_high = config["finemap_thresholds"]["n_high"],
        snp_high = config["finemap_thresholds"]["snp_high"],
        n_mid_low = config["finemap_thresholds"]["n_mid_low"],
        snp_mid_low = config["finemap_thresholds"]["snp_mid_low"],
        timeout_h = config["munge_timeout_hours"],
        ref_lib = ref_lib
    shell:
        r"""

        # Recheck that the coverage file actually says pass before continuing to munge
        # (Edge case where log could claim success but coverage file itself might not)
        if ! grep -q "^PASS$" {input.coverage_check}; then
            echo "$(date): ERROR - coverage check did not pass, refusing to munge" >> {params.log_path}
            exit 1
        fi

        # The SNPlocs/BSgenome reference data packages are too large to ship in the
        # container image, so they live in a shared R library on NFS. R_LIBS is prepended
        # to .libPaths(), leaving the image's own site-library intact. Checked up front
        # because the alternative is a four-hour job dying on "there is no package called
        # 'SNPlocs.Hsapiens.dbSNP155.GRCh38'".
        if [ ! -d "{params.ref_lib}" ]; then
            echo "$(date): ERROR - reference library {params.ref_lib} not found or not mounted in this container" >> {params.log_path}
            exit 1
        fi
        export R_LIBS="{params.ref_lib}"

        for pkg in SNPlocs.Hsapiens.dbSNP155.GRCh38 SNPlocs.Hsapiens.dbSNP155.GRCh37 \
                   BSgenome.Hsapiens.NCBI.GRCh38 BSgenome.Hsapiens.1000genomes.hs37d5; do
            if [ ! -d "{params.ref_lib}/$pkg" ]; then
                echo "$(date): ERROR - reference package $pkg missing from {params.ref_lib}" >> {params.log_path}
                exit 1
            fi
        done

        FNAME=$(cat {input.file_name})

        # Runs munge script
        # Keeping shell errors (e.g. OOT, OOM) separate from R errors.
        # Designates time munge time limit 
        set +e # Allows exit code from Rscropt to be captured and inspected 
        timeout {params.timeout_h}h Rscript pipeline_munge/scripts/munge_sumstats.R \
            {input.sumstats} {output.munged} {output.decision} {params.log_path} \
            {threads} {params.n} {params.n_high} {params.snp_high} \
            {params.n_mid_low} {params.snp_mid_low} "$FNAME"
        EXIT_CODE=$?
        set -e

        # Distinguishes between timeout, out-of-memory kill, and any other failure by exit code
        if [ $EXIT_CODE -eq 124 ]; then
            echo "$(date): ERROR - munge exceeded {params.timeout_h}h time limit (OOT)" >> {params.log_path}
            exit 1
        elif [ $EXIT_CODE -eq 137 ]; then
            echo "$(date): ERROR - munge process killed, likely OOM" >> {params.log_path}
            exit 1
        elif [ $EXIT_CODE -ne 0 ]; then
            echo "$(date): munge exited with code $EXIT_CODE — see prior log lines for R-level error detail" >> {params.log_path}
            exit 1
        fi
        """