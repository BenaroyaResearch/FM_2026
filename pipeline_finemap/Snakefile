        susie_results = f"{LOCUS_OUT_ROOT}/{{study}}/{{locus}}/{WINDOW_LABEL}/{FINEMAPPING_METHOD}/{{locus}}_susie_results.tsv",
        pip_full = f"{LOCUS_OUT_ROOT}/{{study}}/checking/{FINEMAPPING_METHOD}/{WINDOW_LABEL}/{{study}}_pip_full.tsv",
        rescued_snps = rescued_snps_path
    output:
        f"{LOCUS_OUT_ROOT}/{{study}}/{{locus}}/{WINDOW_LABEL}/{FINEMAPPING_METHOD}/{{locus}}_summary.txt"
    params:
        log_path = lambda wildcards: study_info[wildcards.study]["log_file"]
    script:
        "scripts/locus_summary.R"

