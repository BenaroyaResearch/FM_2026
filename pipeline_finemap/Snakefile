rule finalize_study:
    input:
        exclusions = f"{LOCUS_OUT_ROOT}/{{study}}/associations/{WINDOW_LABEL}/{{study}}_exclusions.tsv",
        # Was hardcoded to a literal "results/..." path that silently mismatched
        # build_opentargets_comparison's actual (LOCUS_OUT_ROOT-prefixed) output location --
        # only ever matched because every real run to date used the default LOCUS_OUT_ROOT
        # ("results"). Fixed to reference the same path build_opentargets_comparison declares.
        pip_full = f"{LOCUS_OUT_ROOT}/{{study}}/checking/{FINEMAPPING_METHOD}/{WINDOW_LABEL}/{{study}}_pip_full.tsv",
        summary_files = lambda wildcards: expand(
            LOCUS_OUT_ROOT + "/{{study}}/{locus}/" + WINDOW_LABEL + "/" + FINEMAPPING_METHOD + "/{locus}_summary.txt",
            locus=get_eligible_loci(wildcards)
        ),
        # Forces finalize_study to run last: without these, it has no ordering relationship
        # to the rules that produce them, so it can't reliably report "here's everything
        # that was written" in its completion manifest below.
        final_report = f"{LOCUS_OUT_ROOT}/{{study}}/checking/{FINEMAPPING_METHOD}/{WINDOW_LABEL}/{{study}}_final_report.txt",
        snps_table = f"{LOCUS_OUT_ROOT}/{{study}}/checking/{FINEMAPPING_METHOD}/{WINDOW_LABEL}/{{study}}_snps_table.tsv",
        alignment_summary = f"{LOCUS_OUT_ROOT}/{{study}}/checking/{FINEMAPPING_METHOD}/{WINDOW_LABEL}/{{study}}_alignment_summary.txt",
        locus_r2_summary = f"{LOCUS_OUT_ROOT}/{{study}}/checking/{FINEMAPPING_METHOD}/{WINDOW_LABEL}/{{study}}_locus_r2_summary.txt"
    output:
        f"{LOCUS_OUT_ROOT}/{{study}}/checking/{FINEMAPPING_METHOD}/{WINDOW_LABEL}/study_finalized.txt"
    params:
        log_path = lambda wildcards: study_info[wildcards.study]["log_file"]
    script:
        "scripts/finalize_study.R"

rule locus_summary:
