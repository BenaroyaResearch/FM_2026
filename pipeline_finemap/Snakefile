# Purpose: LD-binned regional (Manhattan) plot for one locus, colored by r^2 to the locus's own
# lead SNP. Reuses the same LD_matrix files run_susie already consumes -- no new PLINK step.
rule build_manhattan_plot:
    input:
        susie_results = f"{LOCUS_OUT_ROOT}/{{study}}/{{locus}}/{WINDOW_LABEL}/{FINEMAPPING_METHOD}/{{locus}}_susie_results.tsv",
        matrix = f"{LOCUS_OUT_ROOT}/{{study}}/{{locus}}/{WINDOW_LABEL}/LD_matrix/{{locus}}.locus.matrix.ld",
        snplist = f"{LOCUS_OUT_ROOT}/{{study}}/{{locus}}/{WINDOW_LABEL}/LD_matrix/{{locus}}.locus.matrix.snplist",
        associations = "results/{study}/associations/{study}_lead_snps.tsv"
    output:
        f"{LOCUS_OUT_ROOT}/{{study}}/{{locus}}/{WINDOW_LABEL}/{FINEMAPPING_METHOD}/{{locus}}_manhattan_plot.pdf"
    params:
        window_bp = config["locus_window_bp"],
        log_path = lambda wildcards: study_info[wildcards.study]["log_file"]
    script:
        "scripts/build_manhattan_plot.R"

# Purpose: pulls every eligible locus's manhattan plot into a single per-study marker so `rule
# all` can depend on it without expanding over loci itself (same pattern as aggregate_ld_matrices).
rule collect_manhattan_plots:
    input:
        lambda wildcards: expand(
            LOCUS_OUT_ROOT + "/{{study}}/{locus}/" + WINDOW_LABEL + "/" + FINEMAPPING_METHOD + "/{locus}_manhattan_plot.pdf",
            locus=get_eligible_loci(wildcards)
        )
    output:
        f"{LOCUS_OUT_ROOT}/{{study}}/{WINDOW_LABEL}/manhattan_plots_done.txt"
    shell:
        "touch {output}"

