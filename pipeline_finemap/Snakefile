rule build_final_report:
    input:
        associations = "results/{study}/associations/{study}_lead_snps.tsv",
        exclusions = f"{LOCUS_OUT_ROOT}/{{study}}/associations/{WINDOW_LABEL}/{{study}}_exclusions.tsv",
        summary_files = lambda wildcards: expand(
            LOCUS_OUT_ROOT + "/{{study}}/{locus}/" + WINDOW_LABEL + "/" + FINEMAPPING_METHOD + "/{locus}_summary.txt",
            locus=get_eligible_loci(wildcards)
        ),
        susie_results = lambda wildcards: expand(
            LOCUS_OUT_ROOT + "/{{study}}/{locus}/" + WINDOW_LABEL + "/" + FINEMAPPING_METHOD + "/{locus}_susie_results.tsv",
            locus=get_eligible_loci(wildcards)
        ),
        susie_summary = lambda wildcards: expand(
            LOCUS_OUT_ROOT + "/{{study}}/{locus}/" + WINDOW_LABEL + "/" + FINEMAPPING_METHOD + "/{locus}_susie_summary.txt",
            locus=get_eligible_loci(wildcards)
        ),
        raw_sumstats = "results/{study}/raw/{study}_sumstats.tsv.gz",
        munged_sumstats = "results/{study}/munged/{study}_munged.tsv.gz"
    output:
        f"{LOCUS_OUT_ROOT}/{{study}}/checking/{FINEMAPPING_METHOD}/{WINDOW_LABEL}/{{study}}_final_report.txt"
    params:
        log_path = lambda wildcards: study_info[wildcards.study]["log_file"]
    script:
        "scripts/build_final_report.R"

